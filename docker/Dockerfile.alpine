FROM python:3.14-alpine
RUN apk add --no-cache build-base libffi-dev openssl-dev
WORKDIR /work
COPY app/ /work/app/
RUN python -m venv /opt/appenv && /opt/appenv/bin/pip install --no-cache-dir -U pip \
 && /opt/appenv/bin/pip install --no-cache-dir -r /work/app/requirements.txt
RUN python -m venv /opt/tools && /opt/tools/bin/pip install --no-cache-dir -U pip pip-audit safety
ENV PATH="/opt/tools/bin:$PATH"
CMD ["sh"]
